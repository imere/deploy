      "default": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@dp/ports": "workspace:*",
    "@dp/log": "workspace:*",
    "@dp/ssh": "workspace:*",
    "@dp/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
