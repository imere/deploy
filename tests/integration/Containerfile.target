# 集成测试的靶机：一台能 SSH 进去、能部署的真实 POSIX 机器。
#
# 这里刻意**不用 alpine**：要用 GNU coreutils 那一侧的 stat / tar / install 行为，
# 它们与 busybox 的差异正是 pure-function 单测覆盖不到的部分。
FROM docker.io/library/node:24-bookworm

# 有些机器的 podman 会把过期的代理写进 engine env，代理不通时 apt 会一直挂着重试。
# 显式清空等价于告诉构建过程「走直连」；没代理的机器上这行是空操作。
ENV http_proxy= https_proxy= HTTP_PROXY= HTTPS_PROXY=
ENV no_proxy= NO_PROXY=

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       ca-certificates openssh-server nginx-light rsync procps sudo curl systemd \
  && rm -rf /var/lib/apt/lists/*

# dp：一个普通部署用户。给它 NOPASSWD sudo 是为了让「become」这条路径也被真跑一遍 ——
# 写 conf.d / unit 目录本来就该提权，全用 root 登录等于绕过了整段提权逻辑
RUN useradd -m -s /bin/bash dp \
  && printf '%s\n' 'dp ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/dp \
  && chmod 0440 /etc/sudoers.d/dp \
  && install -d -o dp -g dp -m 0755 /srv \
  && install -d -o dp -g dp -m 0700 /home/dp/.ssh \
  && install -d -m 0755 /run/sshd \
  && ssh-keygen -A

# 主配置里 conf.d 的 include 必须真的存在，否则 nginx -t 只验证到影子 conf 自己通过，
# 而真正 load 的链路一次都没走过
RUN printf '%s\n' \
      'PermitRootLogin no' \
      'PasswordAuthentication no' \
      'UseDNS no' \
      'Subsystem sftp /usr/lib/openssh/sftp-server' \
      >> /etc/ssh/sshd_config \
  && rm -f /etc/nginx/sites-enabled/default

EXPOSE 22 8080
# 1 号进程是 sleep 而不是 sshd：sshd 由集成脚本显式拉起（起不来时能拿到它的原话，
# 而让 CMD 去跑它只会得到一个 Status: exited）。systemd 那台会用自己的命令覆盖这一行
CMD ["sleep", "infinity"]
