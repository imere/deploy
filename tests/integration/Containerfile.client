# 集成测试的客户端：跑 dp 的那台机器。
#
# 客户端也进容器，是为了让「本机」不成为一个变量 —— 没有 ssh-agent、
# ~/.ssh 的权限语义、缺 rsync 这类差异，会让同一个结果在不同机器上真假难辨。
FROM docker.io/library/node:24-bookworm

# 同靶机：显式清空机器上可能存在的过期代理
ENV http_proxy= https_proxy= HTTP_PROXY= HTTPS_PROXY=
ENV no_proxy= NO_PROXY=

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       ca-certificates openssh-client rsync curl procps jq \
  && rm -rf /var/lib/apt/lists/*

# 已知主机密钥落**真实文件**，而不是 /dev/null。
# dp 默认走 knownHosts: strict（这是设计上的默认值，不是测试里可以放宽的东西），
# 而 strict 读的就是 ssh 自己的 known_hosts —— 指向 /dev/null 等于让 strict 永远查不到密钥，
# 报出来的是「主机密钥与 known_hosts 里记录的不一致」，看着像中间人，实际是夹具把它指空了。
# 文件在容器里，容器即用即弃，所以「把测试机指纹留下来」这件事本身也没有副作用。
RUN printf '%s\n' \
      'Host *' \
      '  StrictHostKeyChecking accept-new' \
      '  UserKnownHostsFile /root/.ssh/known_hosts' \
      > /etc/ssh/ssh_config.d/90-dp-it.conf

CMD ["sleep", "infinity"]
