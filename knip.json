{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tests/**/*.test.mjs",
        "tools/**/*.mjs"
      ],
      "ignoreBinaries": [
        "gitleaks",
        "report"
      ],
      "ignore": [
        ".claude/**"
      ]
    },
    "packages/*": {
      "entry": [
        "dist/lib/index.js"
      ],
      "project": [
        "src/**/*.ts",
        "!src/**/*.test.ts"
      ]
    },
    "packages/cli": {
      "entry": [
        "dist/lib/bin.js",
        "dist/lib/index.js"
      ]
    }
  }
}
