# 临时物
.tmp/

# 工作记忆（只留在本机，不进版本库：里面记的是本机环境与项目处境）
.workbuddy/

# 产物
build/
dist/
coverage/
*.tsbuildinfo

# 编译输出绝不能洒进源码目录（曾经 outDir 没生效时发生过）
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# 依赖
node_modules/

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 密钥（测试用私钥也绝不入库）
*.pem
id_rsa
id_ed25519
id_ed25519.pub
.env
.env.*

# 编辑器/系统
.DS_Store
.vscode/
.idea/
*.swp

# Git Bash 下 ssh UserKnownHostsFile=/dev/null 产生的副作用文件
NUL
nul

# 写权限实证探测的临时文件（正常会被自己删掉；删除被拦截时别让它进版本库）
.dp-w-*
